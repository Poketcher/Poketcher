<?xml version="1.0" encoding="utf-8" ?>
<views:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Poketcher.Features.Settings.SettingsPage"
             xmlns:views="clr-namespace:Poketcher.Features.Base"
             xmlns:viewmodel ="clr-namespace:Poketcher.Features.Settings"
             x:DataType="viewmodel:SettingsViewModel"
             Title="SettingsPage" >
    <Grid RowDefinitions="50,50,50,50,*,*,*,*" RowSpacing="15">
        <Border>
            <Border.GestureRecognizers>
                <TapGestureRecognizer />
            </Border.GestureRecognizers>
            <VerticalStackLayout>
                <Label Text="Export Pokèmon" HorizontalOptions="Center" VerticalOptions="End"/>
            </VerticalStackLayout>
        </Border>
        <Border Grid.Row="1">
            <Border.GestureRecognizers>
                <TapGestureRecognizer/>
            </Border.GestureRecognizers>
            <VerticalStackLayout>
                <Label Text="Import Pokèmon" HorizontalOptions="Center" VerticalOptions="End"/>
            </VerticalStackLayout>
        </Border>
        <Border Grid.Row="2">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding AddTestPokemonsCommand}"/>
            </Border.GestureRecognizers>
            <VerticalStackLayout>
                <Label Text="Populate Pokèmon" HorizontalOptions="Center" VerticalOptions="End"/>
            </VerticalStackLayout>
        </Border>
        <Border Grid.Row="3">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding LoadPokemonDataCommand}"/>
            </Border.GestureRecognizers>
            <VerticalStackLayout>
                <Label Text="Load Pokémon Data" HorizontalOptions="Center" VerticalOptions="End"/>
            </VerticalStackLayout>
        </Border>
        
        <Label Grid.Row="4" Text="Pokémon Catturati" FontAttributes="Bold" HorizontalOptions="Center" />
        <CollectionView Grid.Row="5" ItemsSource="{Binding CaughtPokemons}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <StackLayout Orientation="Horizontal">
                        <Label Text="{Binding PokemonNumber}" />
                        <Label Text="{Binding Game}" />
                        <Label Text="{Binding IsShiny}" />
                        <Label Text="{Binding IsMale}" />
                        <Label Text="{Binding IsCaught}" />
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="6" Text="Pokémon Non Catturati" FontAttributes="Bold" HorizontalOptions="Center" />
        <CollectionView Grid.Row="7" ItemsSource="{Binding UncaughtPokemons}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <StackLayout Orientation="Horizontal">
                        <Label Text="{Binding PokemonNumber}" />
                        <Label Text="{Binding Game}" />
                        <Label Text="{Binding IsShiny}" />
                        <Label Text="{Binding IsMale}" />
                        <Label Text="{Binding IsCaught}" />
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</views:BasePage>